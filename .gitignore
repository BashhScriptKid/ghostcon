# Meson build directories
build/
build-release/
build-san/
build-*/

# Packaging output (packaging/build-pkg.sh writes here)
dist/

# Editor/tooling caches
.cache/

# Meson subproject wrap tooling state (re-derived from *.wrap on fetch)
subprojects/.wraplock
subprojects/packagecache/

# Claude Code runtime state (session locks, not project config)
.claude/

# Vendored UCD input -- large upstream file, fetched on demand by
# tools/fetch_ucd.sh, not committed. src/term/cell_symbol_table.gen.c
# (its generated output) IS committed.
third_party/UnicodeData.txt
third_party/UCD_VERSION

# Root clangd/ccls DB symlink (points at a build dir)
compile_commands.json

# Python bytecode caches from tools/format_*.py
__pycache__/
