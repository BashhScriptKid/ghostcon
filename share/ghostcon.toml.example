# Example ghostcon config. Copy to /etc/ghostcon/ghostcon.toml (or point
# GHOSTCON_CONFIG_PATH at a copy elsewhere) and uncomment/edit as needed.
# A missing file is not an error -- every value below is also the
# hardcoded default undead-head falls back to if this file doesn't exist
# or a key is left out.
#
# At startup, only undead-head reads this file directly -- it
# re-exports every value here as a GHOSTCON_* environment variable for
# the rest of the process tree (ghost-ptyserv, supervisor, ghostcon-core)
# to inherit, same as if you'd set that env var by hand. An env var
# that's already set (e.g. by a test harness, or set manually before
# launching undead-head) always wins over what's written here.
#
# Changes apply LIVE, no restart needed: undead-head/supervisor/
# ghostcon-core each independently watch this file and re-apply
# whatever changed within about a second of saving. Two exceptions --
# drm_node and run_dir set up hardware/filesystem resources at process
# start, so a live edit only takes effect the next time the affected
# process naturally restarts (a crash/hang recovery, or `systemctl
# restart ghostcon.service`), not instantly. Every other key below
# applies with zero restart and no visible disruption (no VT blink, no
# lost session/scrollback).

[general]

# The DRM render node ghostcon-core opens for KMS/GLES rendering. Find
# yours with `ls /dev/dri/` -- on multi-GPU machines this is NOT always
# card0.
# drm_node = "/dev/dri/card1"

# Directory for the ptyserv registry socket and the supervisor's
# recovery/state files.
# run_dir = "/run/ghostcon"

# How long (in milliseconds) the supervisor waits for a canary heartbeat
# from ghostcon-core before assuming it's wedged and falling back.
# canary_deadline_ms = 4000

# Skip the `wall` broadcast the supervisor sends when falling back to
# kmscon/agetty (useful on headless/CI-like setups with no interactive
# users to notify).
# disable_wall = false

# Skip the kmscon fallback entirely on canary failure -- supervisor falls
# straight to a bare agetty instead. Set this if kmscon isn't installed.
# disable_kmscon_fallback = false

# Font size (points) for the terminal's glyph atlas.
# font_size = 16

# Font family/style for the terminal's glyph atlas. Empty (the
# default) uses fontconfig's own default monospace match. font_variant
# maps to fontconfig's FC_STYLE -- run `fc-list <family>` to see what
# a given family actually offers (e.g. "Bold", "Light", "Medium
# Italic"); an unrecognized value just falls through to fontconfig's
# normal default-style behavior, not an error. Unlike most keys above,
# these two are read directly from this file by ghostcon-core itself,
# not re-exported as an env var by undead-head -- still applies live,
# same as everything else on this page.
# font_family = "JetBrainsMono Nerd Font Mono"
# font_variant = "Regular"

# Glyph rasterization mode: "grayscale" (default), "subpixel" (LCD-
# optimized hinting, still a plain coverage mask -- not real
# per-channel color), "cleartype" (true RGB subpixel rendering: real,
# distinct per-channel coverage blended per-channel in the shader --
# see render/gles.c's FRAG_SRC doc comment), or "none" (no
# antialiasing at all). An unrecognized value falls back to
# "grayscale", not an error.
# antialiasing = "grayscale"

# Physical left-to-right subpixel order of the actual display -- only
# matters when antialiasing = "cleartype". "rgb" (default, the common
# laptop-panel layout) or "bgr". Get this wrong and cleartype produces
# visible color fringing instead of removing it.
# subpixel_order = "rgb"

# Luminance-based alpha correction on glyph edges (ported from
# Ghostty's own text shader). Defaults off -- Ghostty only pairs this
# with a true linear-space-blending framebuffer ghostcon doesn't have;
# applied without it, this over-darkens partially-covered pixels,
# making thin strokes read visibly dimmer than thick ones within the
# same glyph. See render/gles.c's FRAG_SRC doc comment before turning
# this on.
# gamma_correct = false

# Named color-theme preset. Two sources, checked in order:
# 1. A small curated set with short, memorable names: "base16-dark",
#    "base16-light", "solarized-dark", "solarized-light".
# 2. Ghostty's own full bundled theme catalog (600+ entries, generated
#    from Ghostty's real theme files -- see term/theme_ghostty_presets.c
#    and tools/gen_ghostty_themes.py). A `theme = "..."` value copied
#    verbatim out of a real Ghostty config resolves to the exact same
#    colors here -- e.g. theme = "Apple System Colors" or
#    theme = "Dracula" work exactly as they do in Ghostty. Case-
#    sensitive exact match, same as Ghostty's own theme names.
# Empty (default) = ghostcon's built-in xterm-ish defaults. An
# unrecognized name falls back to those same defaults, not an error.
# Applies live. See [colors] below for explicit per-color overrides
# layered on top of whichever theme (or lack of one) is active --
# same preset-then-explicit-override precedence [cursor]'s fields
# already use.
# theme = "base16-dark"

# Explicit per-color overrides, applied AFTER `theme` above. Leave a
# key out (or comment it) to inherit whatever the theme/built-in
# default set for it instead of overriding it. Accepts #RGB,
# #RRGGBB, #RRRGGGBBB, #RRRRGGGGBBBB, or X11 "rgb:R/G/B" -- an
# unparseable value is ignored, not an error. color0-color15 are the
# ANSI palette slots in the standard order (0=black, 1=red, ...
# 7=white, 8=bright black, ... 15=bright white).
# [colors]
# background = "#1a1b26"
# foreground = "#c0caf5"
# cursor = "#c0caf5"
# color0 = "#15161e"
# color1 = "#f7768e"
# color2 = "#9ece6a"
# color3 = "#e0af68"
# color4 = "#7aa2f7"
# color5 = "#bb9af7"
# color6 = "#7dcfff"
# color7 = "#a9b1d6"
# color8 = "#414868"
# color9 = "#f7768e"
# color10 = "#9ece6a"
# color11 = "#e0af68"
# color12 = "#7aa2f7"
# color13 = "#bb9af7"
# color14 = "#7dcfff"
# color15 = "#c0caf5"

# Scrollback history capacity, in lines. Startup-only -- a live edit
# takes effect the next time ghostcon-core naturally restarts, not
# instantly (same exception as drm_node/run_dir above).
# scrollback_lines = 2000

# Key auto-repeat timing, milliseconds. Startup-only in the same
# sense as scrollback_lines above, but with a shorter effective delay
# in practice: the input context (and so the repeat timer) is rebuilt
# from scratch on every VT release/reacquire anyway, so a live edit
# takes effect next time you switch away from and back to this VT,
# not next restart.
# repeat_delay_ms = 250
# repeat_rate_ms = 50

[mouse]

# Disable this device class entirely -- no movement, clicks, or
# scroll at all.
# enable = true

# Multiplier on how many terminal-scroll lines a raw scroll event
# produces: 1.0 is unchanged passthrough, > 1.0 amplifies (multiple
# lines per wheel detent), < 1.0 throttles (multiple detents needed
# before one line reaches the app).
# scroll_speed = 1.0

# libinput's own pointer-acceleration speed, -1.0 (slowest) to 1.0
# (fastest); 0.0 is libinput's own default.
# sensitivity = 0.0

[touchpad]

# enable = true
# scroll_speed = 1.0
# sensitivity = 0.0

# Tap the touchpad to click, instead of requiring a physical press.
# tap_to_click = true

# Reverse scroll direction to match touch-content-follows-fingers
# convention (macOS-style), instead of the traditional wheel-style
# direction.
# natural_scroll = false

# Wipe the screen and scrollback the moment a login session ends
# (before the next one's login prompt appears), instead of leaving the
# old session's last screenful visible underneath it. Set to false to
# keep the old behavior.
# clear_on_logout = true

# Font size (points) changed per Ctrl+=/Ctrl+Minus press. 1 is not
# recommended -- FreeType/fontconfig round the cell width and height
# metrics to whole pixels independently, and at 1pt granularity they
# frequently don't cross that rounding boundary together, producing a
# visibly stretched cell (height changes, width doesn't) for one press
# before a later press catches width up. 2 avoids that in practice.
# zoom_step = 2
